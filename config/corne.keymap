#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        combos {
                compatible = "zmk,combos";
                combo_l3 {
                        timeout-ms = <50>;
                        key-positions = <36 41>;
                        bindings = <&mo 3>;
                };
                combo_rsft {
                        timeout-ms = <50>;
                        key-positions = <7 19>;
                        bindings = <&kp RSHFT>;
                };
                combo_lsft {
                        timeout-ms = <50>;
                        key-positions = <4 16>;
                        bindings = <&kp LSHFT>;
                };
                combo_rgui {
                        timeout-ms = <50>;
                        key-positions = <8 20>;
                        bindings = <&kp RGUI>;
                };
                combo_lgui {
                        timeout-ms = <50>;
                        key-positions = <3 15>;
                        bindings = <&kp LGUI>;
                };
                combo_ralt {
                        timeout-ms = <50>;
                        key-positions = <9 21>;
                        bindings = <&kp RALT>;
                };
                combo_lalt {
                        timeout-ms = <50>;
                        key-positions = <2 14>;
                        bindings = <&kp LALT>;
                };
                combo_rctrl {
                        timeout-ms = <50>;
                        key-positions = <10 22>;
                        bindings = <&kp RCTRL>;
                };
                combo_lctrl {
                        timeout-ms = <50>;
                        key-positions = <1 13>;
                        bindings = <&kp LCTRL>;
                };
                combo_plus {
                        timeout-ms = <50>;
                        key-positions = <6 18>;
                        bindings = <&kp PLUS>;
                };
                combo_equal {
                        timeout-ms = <50>;
                        key-positions = <18 30>;
                        bindings = <&kp EQUAL>;
                };
                combo_under {
                        timeout-ms = <50>;
                        key-positions = <5 17>;
                        bindings = <&kp UNDER>;
                };
                combo_minus {
                        timeout-ms = <50>;
                        key-positions = <17 29>;
                        bindings = <&kp MINUS>;
                };
                combo_grave {
                        timeout-ms = <50>;
                        key-positions = <16 28>;
                        bindings = <&kp GRAVE>;
                };
                combo_pipe {
                        timeout-ms = <50>;
                        key-positions = <15 27>;
                        bindings = <&kp PIPE>;
                };
                combo_tilde {
                        timeout-ms = <50>;
                        key-positions = <19 31>;
                        bindings = <&kp TILDE>;
                };
                combo_backslash {
                        timeout-ms = <50>;
                        key-positions = <20 32>;
                        bindings = <&kp BSLH>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// | TAB      |  Q  |  W  |  E  |  R  |  T  |     |  Y  |  U   |  I  |  O  |  P  | BKSP   |
// | CTRL,ESC |  A  |  S  |  D  |  F  |  G  |     |  H  |  J   |  K  |  L  |  ;  |  '     |
// | SHFT,(   |  Z  |  X  |  C  |  V  |  B  |     |  N  |  M   |  ,  |  .  |  /  | SHFT,) |
//                  | LWR | GUI | ENT |     | SPC | ALT | RSE  | 
                        bindings = <
   &kp TAB        &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BACKSPACE
   &mt LCTRL ESC  &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &mt LSHFT LPAR &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &mt RSHFT RPAR
                        &mo 1 &kp LGUI  &kp RET   &kp SPACE &kp RALT &mo 2
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7   |  8      |  9    |  0  | DEL |
// |      |     |     |  {  |  }  | LFT |   | CAPS| LFT  | UP      |  RGT  |     |     |
// | SHFT |     |     |  [  |  ]  | LFT |   |     | ALT-L| DWN     | ALT-R |     |     |
//                    |     |     | ENT |   | SPC |      | CMD+GRV |
                        bindings = <
   &kp TAB  &kp N1       &kp N2   &kp N3    &kp N4    &kp N5    &kp N6   &kp N7        &kp N8    &kp N9         &kp N0  &kp DELETE
   &trans   &trans       &trans   &kp LBRC  &kp RBRC  &kp LEFT  &kp CAPS &kp LEFT      &kp UP    &kp RIGHT      &trans  &trans
   &trans   &trans       &trans   &kp LBKT  &kp RBKT  &kp LEFT  &trans   &kp RA(LEFT)  &kp DOWN  &kp RA(RIGHT)  &trans  &trans
                         &trans   &trans    &kp RET   &kp SPACE &trans   &kp RG(GRAVE)
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB     |  !  |  @  |  #  |  $  |  %  |     |  ^  |  &  |  *  |  (  |  )  | DEL |
// | CTRL,ESC |  _  |  +  |  {  |  }  | "|" |     |  ~  |     |     |     |     |     |
// | SHFT     |  -  |  =  |  [  |  ]  |  \  |     |  `  |     |     |     |     |     |
//                  |     |     | ENT |     | SPC |     |     |
                        bindings = <
   &kp  TAB    &kp EXCL  &kp AT    &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &trans
   &trans      &kp UNDER &kp PLUS  &kp LBRC &kp RBRC &kp PIPE    &kp TILDE &trans    &trans          &trans   &trans   &trans
   &kp LSHFT   &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH    &kp GRAVE &trans    &trans          &trans   &trans   &trans
                    	          &trans &trans   &kp RET     &kp SPACE &trans    &trans
                        >;
                };

                control_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | CAPS| LFT | DWN |  UP | RGT |      |
// | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
//                    | GUI |     | ENT |   | SPC |     | ALT |
                        bindings = <
   &kp TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &trans
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp CAPS &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans
   &studio_unlock  &trans       &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &mt RSHFT RPAR
                          	        &trans     &trans       &kp RET        &kp SPACE  &trans   &none
                        >;
                };
        };
};
